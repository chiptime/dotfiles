[Unit]
Description=OpenCode Mobile Reverse Proxy
After=network.target opencode-web.service
Wants=opencode-web.service

[Service]
Type=simple
WorkingDirectory=/home/bruno/Code/personal/hungry/compare-prices
ExecStart=/bin/bash -c 'test -r /home/bruno/.dotfiles/shell/private-env.sh && . /home/bruno/.dotfiles/shell/private-env.sh; exec /home/bruno/.bun/bin/bun run scripts/mobile-proxy.ts'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
