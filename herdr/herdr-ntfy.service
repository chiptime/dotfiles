[Unit]
Description=Herdr agent notification watcher (ntfy.sh push)
After=network.target
# Only run while herdr server is available
ConditionPathExists=/home/bruno/.config/herdr/herdr.sock

[Service]
Type=simple
ExecStart=/home/bruno/bin/herdr-ntfy
Restart=on-failure
RestartSec=10
Environment=HERDR_NTFY_TOPIC=bruno-herdr-4VHsmCGC
# Uncomment to use self-hosted ntfy:
# Environment=HERDR_NTFY_SERVER=https://your-ntfy.example.com

[Install]
WantedBy=default.target
