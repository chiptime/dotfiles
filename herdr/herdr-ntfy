#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════╗
# ║  herdr-ntfy — Push mobile notifications on agent events  ║
# ║  Uses `herdr agent wait` (event-driven, no polling).     ║
# ╚═══════════════════════════════════════════════════════════╝
#
# Usage:
#   herdr-ntfy                      # watch all agents
#   herdr-ntfy --topic my-topic     # custom ntfy topic
#   herdr-ntfy --agent claude       # watch specific agent only
#   herdr-ntfy --once               # notify once then exit
#
# Setup:
#   1. Install ntfy app on phone (Android/iOS)
#   2. Subscribe to your topic (e.g. "bruno-herdr-x9k2")
#   3. Set HERDR_NTFY_TOPIC env var or use --topic
#
# Architecture:
#   Instead of polling, this script uses `herdr agent wait` which
#   blocks on the socket API until an agent state changes. Zero CPU
#   usage while waiting. One watcher loop per tracked agent.

set -euo pipefail

export PATH="/home/bruno/bin:/home/linuxbrew/.linuxbrew/bin:${PATH}"
export HERDR_SOCKET_PATH="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"

NTFY_TOPIC="${HERDR_NTFY_TOPIC:-}"
NTFY_SERVER="${HERDR_NTFY_SERVER:-https://ntfy.sh}"
WATCH_AGENT=""
ONCE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --topic)  NTFY_TOPIC="$2"; shift 2 ;;
    --server) NTFY_SERVER="$2"; shift 2 ;;
    --agent)  WATCH_AGENT="$2"; shift 2 ;;
    --once)   ONCE=true; shift ;;
    --help|-h)
      cat <<'EOF'
Usage: herdr-ntfy [--topic TOPIC] [--server URL] [--agent NAME] [--once]

Environment variables:
  HERDR_NTFY_TOPIC   ntfy topic name (required)
  HERDR_NTFY_SERVER  ntfy server URL (default: https://ntfy.sh)

Options:
  --topic TOPIC     ntfy topic (overrides HERDR_NTFY_TOPIC)
  --server URL      ntfy server URL (default: https://ntfy.sh)
  --agent NAME      watch a specific agent only (default: all)
  --once            exit after first notification
EOF
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$NTFY_TOPIC" ]]; then
  echo "Error: Set HERDR_NTFY_TOPIC or use --topic <topic>" >&2
  exit 1
fi

NTFY_URL="${NTFY_SERVER}/${NTFY_TOPIC}"

COLLIE_URL="${HERDR_COLLIE_URL:-https://desktop-q02omrn.tail2640fd.ts.net}"

# ─── Notification helpers ────────────────────────────────────

send_ntfy() {
  local title="$1" body="$2" priority="${3:-default}" tags="${4:-robot}" actions="${5:-}" audio_path="${6:-}" pane_id="${7:-}"
  local pane_url="${COLLIE_URL}${pane_id:+/pane/${pane_id}}"

  local -a headers=(
    -H "Title: ${title}"
    -H "Priority: ${priority}"
    -H "Tags: ${tags}"
    -H "Click: ${pane_url}"
  )
  if [[ -n "$actions" ]]; then
    headers+=(-H "Actions: ${actions}")
  fi

  if [[ -n "$audio_path" && -f "$audio_path" && -s "$audio_path" ]]; then
    local safe_body="${body//$'\n'/ · }"
    local audio_bytes
    audio_bytes=$(stat -c%s "$audio_path" 2>/dev/null || echo "unknown")
    headers+=(
      -H "Message: ${safe_body}"
      -H "Filename: ${pane_id//:/_}-response.mp3"
    )
    echo "  [ntfy] 📤 Enviando notificación con audio adjunto (${audio_bytes} bytes) para ${pane_id}"
    curl -s "${headers[@]}" -T "${audio_path}" "${NTFY_URL}" > /dev/null 2>&1 || true
  else
    echo "  [ntfy] 📤 Enviando notificación de texto plano para ${pane_id}"
    curl -s "${headers[@]}" -d "${body}" "${NTFY_URL}" > /dev/null 2>&1 || true
  fi
}

notify_state_change() {
  local pane_id="$1" agent="$2" prev_state="$3" new_state="$4" workspace="${5:-}" title_desc="${6:-}"
  local focus_cmd="herdr agent focus ${pane_id}"
  local pane_url="${COLLIE_URL}/pane/${pane_id}"
  local action_buttons="view, 📱 Abrir Collie, ${pane_url}; view, 📋 Copiar comando, ${focus_cmd}, clear=true"
  local display_name="${agent} (${pane_id})"
  if [[ -n "$title_desc" && "$title_desc" != "$agent" ]]; then
    display_name="${agent} [${title_desc}] (${pane_id})"
  fi

  local audio_file=""
  local tmp_audio="/tmp/herdr-ntfy-${pane_id//:/_}-${BASHPID:-$$}-$RANDOM.mp3"

  case "$new_state" in
    done)
      sleep 0.6
      if command -v herdr-tts >/dev/null 2>&1; then
        if herdr-tts --render-pane "$pane_id" "$tmp_audio" >/dev/null 2>&1 && [[ -s "$tmp_audio" ]]; then
          audio_file="$tmp_audio"
        fi
      fi

      local ntfy_tags="white_check_mark,robot"
      [[ -n "$audio_file" ]] && ntfy_tags="white_check_mark,robot,loudspeaker"

      send_ntfy \
        "✅ ${display_name} terminó" \
        "Agente ${display_name}${workspace:+ en ${workspace}} finalizó su tarea.\n\n→ Para ver: ${focus_cmd}" \
        "default" \
        "${ntfy_tags}" \
        "${action_buttons}" \
        "${audio_file}" \
        "${pane_id}"
      ;;
    blocked)
      sleep 0.6
      if command -v herdr-tts >/dev/null 2>&1; then
        if herdr-tts --render-pane "$pane_id" "$tmp_audio" >/dev/null 2>&1 && [[ -s "$tmp_audio" ]]; then
          audio_file="$tmp_audio"
        fi
      fi

      local ntfy_tags="rotating_light,warning"
      [[ -n "$audio_file" ]] && ntfy_tags="rotating_light,warning,loudspeaker"

      send_ntfy \
        "🔴 ${display_name} necesita atención" \
        "Agente ${display_name}${workspace:+ en ${workspace}} está bloqueado y espera input.\n\n→ Para ver: ${focus_cmd}" \
        "high" \
        "${ntfy_tags}" \
        "${action_buttons}" \
        "${audio_file}" \
        "${pane_id}"
      ;;
    idle)
      if [[ "$prev_state" == "working" ]]; then
        send_ntfy \
          "💤 ${display_name} idle" \
          "Agente ${display_name}${workspace:+ en ${workspace}} pasó a idle." \
          "low" \
          "zzz" \
          "" \
          "" \
          "${pane_id}"
      fi
      ;;
  esac

  [[ -n "$audio_file" && -f "$audio_file" ]] && rm -f "$audio_file"
}

# ─── Single pane watcher (event-driven via herdr agent wait) ──

watch_pane() {
  local pane_id="$1"
  local agent_name="$2"
  local prev_state=""

  # Get initial state
  local info
  info=$(herdr agent get "$pane_id" 2>/dev/null) || true
  prev_state=$(echo "$info" | jq -r '.result.agent.agent_status // .result.agent_status // "unknown"' 2>/dev/null || echo "unknown")

  echo "  👀 Watching ${agent_name} [${pane_id}] (current: ${prev_state})"

  while true; do
    # Block until agent reaches done, blocked, or idle (socket event-driven)
    herdr agent wait "$pane_id" --until done --until blocked --until idle 2>/dev/null || {
      sleep 4
      continue
    }

    info=$(herdr agent get "$pane_id" 2>/dev/null) || { sleep 4; continue; }
    local new_state
    new_state=$(echo "$info" | jq -r '.result.agent.agent_status // .result.agent_status // "unknown"' 2>/dev/null || echo "unknown")

    if [[ "$new_state" != "$prev_state" && -n "$prev_state" && "$new_state" != "unknown" ]]; then
      local workspace
      workspace=$(echo "$info" | jq -r '.result.agent.workspace_id // .result.workspace_id // ""' 2>/dev/null || true)
      local title_desc
      title_desc=$(echo "$info" | jq -r '.result.agent.terminal_title_stripped // .result.agent.terminal_title // .result.terminal_title // ""' 2>/dev/null || true)

      echo "[$(date +%H:%M:%S)] ${agent_name} [${pane_id}]: ${prev_state} → ${new_state}"
      notify_state_change "$pane_id" "$agent_name" "$prev_state" "$new_state" "$workspace" "$title_desc"

      if [[ "$ONCE" == true ]]; then
        echo "  --once: exiting after notification"
        exit 0
      fi
    fi

    prev_state="$new_state"

    # If agent is done/blocked/idle, wait for it to go back to working before looping
    if [[ "$new_state" == "done" || "$new_state" == "blocked" || "$new_state" == "idle" ]]; then
      herdr agent wait "$pane_id" --until working 2>/dev/null || sleep 4
      prev_state="working"
    fi
  done
}

# ─── Main ────────────────────────────────────────────────────

echo "🔔 herdr-ntfy → ${NTFY_URL}"

if [[ -n "$WATCH_AGENT" ]]; then
  if [[ "$WATCH_AGENT" =~ ^w[0-9]+:p[0-9]+$ ]]; then
    watch_pane "$WATCH_AGENT" "agent"
  else
    target_pane=$(herdr agent list 2>/dev/null | jq -r --arg a "$WATCH_AGENT" '.result.agents[]? | select(.agent == $a) | .pane_id' | head -n 1)
    if [[ -n "$target_pane" ]]; then
      watch_pane "$target_pane" "$WATCH_AGENT"
    else
      echo "Error: No se encontró ningún pane para el agente $WATCH_AGENT" >&2
      exit 1
    fi
  fi
else
  echo "  Discovering agents across all panes..."

  CHILD_PIDS=()
  cleanup() {
    for pid in "${CHILD_PIDS[@]:-}"; do
      kill "$pid" 2>/dev/null || true
    done
    rm -f /tmp/herdr-ntfy-*.lock 2>/dev/null || true
    exit 0
  }
  trap cleanup EXIT INT TERM

  while true; do
    raw_agents=$(herdr agent list 2>/dev/null) || { sleep 5; continue; }

    while IFS=$'\t' read -r pane_id agent_name; do
      [[ -z "$pane_id" || "$pane_id" == "null" ]] && continue

      lock_file="/tmp/herdr-ntfy-${pane_id//:/_}.lock"
      if [[ -f "$lock_file" ]]; then
        existing_pid=$(cat "$lock_file" 2>/dev/null || true)
        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
          continue
        fi
      fi

      watch_pane "$pane_id" "$agent_name" &
      child_pid=$!
      echo "$child_pid" > "$lock_file"
      CHILD_PIDS+=("$child_pid")
    done < <(echo "$raw_agents" | jq -r '.result.agents[]? | "\(.pane_id)\t\(.agent)"' 2>/dev/null || true)

    sleep 6
  done
fi
