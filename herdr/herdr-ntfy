#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════╗
# ║  herdr-ntfy — Push mobile notifications on agent events  ║
# ║  Uses `herdr agent wait` (event-driven, no polling).     ║
# ╚═══════════════════════════════════════════════════════════╝
#
# Usage:
#   herdr-ntfy                      # watch all agents
#   herdr-ntfy --topic my-topic     # custom ntfy topic
#   herdr-ntfy --agent claude       # watch specific agent only
#   herdr-ntfy --once               # notify once then exit
#
# Setup:
#   1. Install ntfy app on phone (Android/iOS)
#   2. Subscribe to your topic (e.g. "bruno-herdr-x9k2")
#   3. Set HERDR_NTFY_TOPIC env var or use --topic
#
# Architecture:
#   Instead of polling, this script uses `herdr agent wait` which
#   blocks on the socket API until an agent state changes. Zero CPU
#   usage while waiting. One watcher loop per tracked agent.

set -euo pipefail

NTFY_TOPIC="${HERDR_NTFY_TOPIC:-}"
NTFY_SERVER="${HERDR_NTFY_SERVER:-https://ntfy.sh}"
WATCH_AGENT=""
ONCE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --topic)  NTFY_TOPIC="$2"; shift 2 ;;
    --server) NTFY_SERVER="$2"; shift 2 ;;
    --agent)  WATCH_AGENT="$2"; shift 2 ;;
    --once)   ONCE=true; shift ;;
    --help|-h)
      cat <<'EOF'
Usage: herdr-ntfy [--topic TOPIC] [--server URL] [--agent NAME] [--once]

Environment variables:
  HERDR_NTFY_TOPIC   ntfy topic name (required)
  HERDR_NTFY_SERVER  ntfy server URL (default: https://ntfy.sh)

Options:
  --topic TOPIC     ntfy topic (overrides HERDR_NTFY_TOPIC)
  --server URL      ntfy server URL (default: https://ntfy.sh)
  --agent NAME      watch a specific agent only (default: all)
  --once            exit after first notification
EOF
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$NTFY_TOPIC" ]]; then
  echo "Error: Set HERDR_NTFY_TOPIC or use --topic <topic>" >&2
  exit 1
fi

NTFY_URL="${NTFY_SERVER}/${NTFY_TOPIC}"

COLLIE_URL="${HERDR_COLLIE_URL:-https://desktop-q02omrn.tail2640fd.ts.net}"

# ─── Notification helpers ────────────────────────────────────

send_ntfy() {
  local title="$1" body="$2" priority="${3:-default}" tags="${4:-robot}" actions="${5:-}"
  local -a headers=(
    -H "Title: ${title}"
    -H "Priority: ${priority}"
    -H "Tags: ${tags}"
    -H "Click: ${COLLIE_URL}"
  )
  if [[ -n "$actions" ]]; then
    headers+=(-H "Actions: ${actions}")
  fi
  curl -s "${headers[@]}" -d "${body}" "${NTFY_URL}" > /dev/null 2>&1
}

notify_state_change() {
  local agent="$1" prev_state="$2" new_state="$3" workspace="${4:-}"
  local focus_cmd="herdr agent focus ${agent}"
  local action_buttons="view, 📱 Abrir Collie, ${COLLIE_URL}; view, 📋 Copiar comando, ${focus_cmd}, clear=true"

  case "$new_state" in
    done)
      send_ntfy \
        "✅ ${agent} terminó" \
        "Agente ${agent}${workspace:+ en ${workspace}} finalizó su tarea.\n\n→ Para ver: ${focus_cmd}" \
        "default" \
        "white_check_mark,robot" \
        "${action_buttons}"
      ;;
    blocked)
      send_ntfy \
        "🔴 ${agent} necesita atención" \
        "Agente ${agent}${workspace:+ en ${workspace}} está bloqueado y espera input.\n\n→ Para ver: ${focus_cmd}" \
        "high" \
        "rotating_light,warning" \
        "${action_buttons}"
      ;;
    idle)
      if [[ "$prev_state" == "working" ]]; then
        send_ntfy \
          "💤 ${agent} idle" \
          "Agente ${agent}${workspace:+ en ${workspace}} pasó a idle." \
          "low" \
          "zzz"
      fi
      ;;
  esac
}

# ─── Single agent watcher (event-driven via herdr agent wait) ─

watch_agent() {
  local agent="$1"
  local prev_state=""

  # Get initial state
  prev_state=$(herdr agent get "$agent" 2>/dev/null | jq -r '.result.agent_status // "unknown"') || prev_state="unknown"

  echo "  👀 Watching ${agent} (current: ${prev_state})"

  while true; do
    # Block until agent reaches done, blocked, or idle (default behavior)
    # This uses the socket API internally — zero polling, zero CPU
    wait_result=$(herdr agent wait "$agent" 2>/dev/null) || {
      # Agent might have disappeared; sleep and retry
      sleep 5
      continue
    }

    # Get new state after wait returns
    new_state=$(herdr agent get "$agent" 2>/dev/null | jq -r '.result.agent_status // "unknown"') || continue

    if [[ "$new_state" != "$prev_state" && -n "$prev_state" ]]; then
      # Get workspace for context
      workspace=$(herdr agent get "$agent" 2>/dev/null | jq -r '.result.workspace_id // ""') || workspace=""

      echo "[$(date +%H:%M:%S)] ${agent}: ${prev_state} → ${new_state}"
      notify_state_change "$agent" "$prev_state" "$new_state" "$workspace"

      if [[ "$ONCE" == true ]]; then
        echo "  --once: exiting after notification"
        exit 0
      fi
    fi

    prev_state="$new_state"

    # If agent is done/blocked/idle, wait for it to go back to working before looping
    if [[ "$new_state" == "done" || "$new_state" == "blocked" || "$new_state" == "idle" ]]; then
      herdr agent wait "$agent" --until working 2>/dev/null || sleep 5
      prev_state="working"
    fi
  done
}

# ─── Main ────────────────────────────────────────────────────

echo "🔔 herdr-ntfy → ${NTFY_URL}"

if [[ -n "$WATCH_AGENT" ]]; then
  # Watch a single named agent
  watch_agent "$WATCH_AGENT"
else
  # Watch all agents — discover and spawn watchers
  echo "  Discovering agents..."

  # Track child PIDs for cleanup
  CHILD_PIDS=()
  cleanup() {
    for pid in "${CHILD_PIDS[@]}"; do
      kill "$pid" 2>/dev/null || true
    done
    exit 0
  }
  trap cleanup EXIT INT TERM

  # Discovery loop: check for new agents periodically
  while true; do
    agents=$(herdr agent list 2>/dev/null | jq -r '.result.agents[]?.agent' 2>/dev/null) || { sleep 5; continue; }

    for agent in $agents; do
      # Skip if we're already watching this agent
      lock_file="/tmp/herdr-ntfy-${agent}.lock"
      if [[ -f "$lock_file" ]] && kill -0 "$(cat "$lock_file")" 2>/dev/null; then
        continue
      fi

      # Spawn watcher in background
      (
        echo "$$" > "$lock_file"
        watch_agent "$agent"
      ) &
      CHILD_PIDS+=($!)
    done

    # Re-scan for new agents every 10 seconds
    sleep 10
  done
fi
