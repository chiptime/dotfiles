[Unit]
Description=Launchpad - local app/service launcher (launchpad)
Documentation=file://%h/.dotfiles/tools/launchpad/README.md

[Service]
ExecStart=%h/.local/bin/launchpad
Environment=LAUNCHPAD_PORT=47625
Environment=LAUNCHPAD_HOST=0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
